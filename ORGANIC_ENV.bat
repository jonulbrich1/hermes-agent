@echo off
set ORGANIC_PROJECT_ROOT=%~dp0
set ORGANIC_PROJECT_ROOT=%ORGANIC_PROJECT_ROOT:~0,-1%
set ORGANIC_HOME=%ORGANIC_PROJECT_ROOT%\runtime\organic_home
set ORGANIC_MVP_DATA_DIR=%ORGANIC_HOME%\mvp
set ORGANIC_TRACE_DIR=%ORGANIC_HOME%\traces
set ORGANIC_REVIEW_DIR=%ORGANIC_PROJECT_ROOT%\reveiw
set ORGANIC_BACKEND=mvp
set ORGANIC_IDLE_GROWTH_ENABLED=1
set ORGANIC_WEB_PROVIDER=auto
set ORGANIC_PROCESSOR_MAX_CYCLES=16
set ORGANIC_SEMANTIC_MODE=pydantic
set ORGANIC_MODEL=ollama:qwen3:0.6b
set OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
set ORGANIC_RUNTIME_URL=http://127.0.0.1:8788
set ORGANIC_HERMES_MODE=1
set ORGANIC_SEMANTIC_INTERFACE=1
set HERMES_TUI_TOOLSETS=all
if not defined ORGANIC_HERMES_CHAT_MODEL set ORGANIC_HERMES_CHAT_MODEL=gemma4:e2b
set HERMES_MODEL=%ORGANIC_HERMES_CHAT_MODEL%
set HERMES_INFERENCE_MODEL=%ORGANIC_HERMES_CHAT_MODEL%
set HERMES_TUI_PROVIDER=custom
set HERMES_INFERENCE_PROVIDER=custom
set CUSTOM_BASE_URL=http://127.0.0.1:11434/v1
set OPENAI_API_KEY=no-key-required
set PYTHONPATH=%ORGANIC_PROJECT_ROOT%\organic_runtime\src;%PYTHONPATH%
